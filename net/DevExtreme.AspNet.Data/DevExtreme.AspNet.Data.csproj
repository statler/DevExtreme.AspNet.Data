<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>2.0.2</Version>
    <PackageId>DXAutomap.AspNet.Data</PackageId>
    <Description>DevExtreme server-side data loading for .NET 10 with AutoMapperMIT projections and runtime-context-aware custom accessors.</Description>
    <Authors>Devexpress_Statler</Authors>
    <PackageProjectUrl>https://github.com/statler/DevExtreme.AspNet.Data</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.0.2 has the same code as 2.0.1. It is built from the commit tagged civilpro-v2.0.2 and records that commit, and its README documents the typed-load selector rules from 2.0.1: typed loads (LoadAsync&lt;TSource, TDto&gt;) accept only selectors that name members of the DTO, and selectors that name only source members throw ArgumentException. Requires .NET 10 and AutoMapperMIT 14.0.3. See docs/civilpro/RELEASE-2.x.x.md in the source repository.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/statler/DevExtreme.AspNet.Data</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>2.0.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>DXAutomap.AspNet.Data</AssemblyName>
    <AssemblyVersion>2.0.2.0</AssemblyVersion>
    <FileVersion>2.0.2.0</FileVersion>
    <!-- Only the framework of the API that consumes this package. Add a .NET Framework target only when a .NET Framework consumer needs it. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- System.Text.Json and Microsoft.CSharp come from the shared framework, so they have no package references. -->
  <ItemGroup>
    <PackageReference Include="AutoMapperMIT" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
    <None Update="Types\AnonType.Generated.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>AnonType.Generated.cs</LastGenOutput>
    </None>
    <Compile Update="Types\AnonType.Generated.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>AnonType.Generated.tt</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
  </ItemGroup>

</Project>
